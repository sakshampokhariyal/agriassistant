# Copy to .env.local (never commit .env.local).
# data.gov.in API key for the Agmarknet "Current Daily Price of Various Commodities" resource.
# Used only by the Vite dev/preview proxy (server-side) – it is NOT bundled into the website.
DATA_GOV_API_KEY=your-data-gov-in-api-key

# Supabase (email + password auth). The anon/publishable key is safe to expose in the browser;
# protect data with Row Level Security policies in Supabase.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
