{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/proxy/(.*)", "destination": "/api/proxy?path=$1" },
    { "source": "/((?!api/|assets/).*)", "destination": "/index.html" }
  ]
}
